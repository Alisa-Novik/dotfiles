#!/usr/bin/env bash

# The everyday action balances the current workspace, preserving its tree and
# every window's placement/layout. Global reset is deliberately explicit.
set -u

AEROSPACE_BIN="${AEROSPACE_BIN:-/opt/homebrew/bin/aerospace}"
ROUTER="${AEROSPACE_ROUTER:-${HOME}/.local/bin/aerospace-route-window}"
NOTIFY=1
DRY_RUN=0
RESET_ALL=0

usage() {
  printf 'Usage: %s [--reset-all] [--no-notify] [--dry-run]\n' "${0##*/}"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --reset-all) RESET_ALL=1 ;;
    --no-notify|--startup) NOTIFY=0 ;;
    --dry-run) DRY_RUN=1; NOTIFY=0 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

notify() {
  [ "$NOTIFY" -eq 1 ] || return 0
  /usr/bin/osascript - "$1" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  display notification (item 1 of argv) with title "AeroSpace align"
end run
APPLESCRIPT
}

fail() {
  printf 'AeroSpace align: %s\n' "$*" >&2
  notify "$*"
  return 1
}

if [ ! -x "$AEROSPACE_BIN" ]; then
  fail "AeroSpace CLI is not installed."
  exit 1
fi

if [ "$RESET_ALL" -eq 0 ]; then
  if ! workspace="$("$AEROSPACE_BIN" list-workspaces --focused --format '%{workspace}')" \
    || [ -z "$workspace" ]; then
    fail "Could not determine the focused workspace."
    exit 1
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'would balance sizes on workspace=%s; preserve placement and layout\n' "$workspace"
    exit 0
  fi
  if ! "$AEROSPACE_BIN" balance-sizes --workspace "$workspace"; then
    fail "Could not balance workspace $workspace. See stderr for details."
    exit 1
  fi
  notify "Balanced workspace $workspace."
  exit 0
fi

if [ ! -x "$ROUTER" ]; then
  fail "Routing helper is not installed."
  exit 1
fi
if ! windows="$("$AEROSPACE_BIN" list-windows --all \
  --format '%{window-id}%{tab}%{app-pid}%{tab}%{app-bundle-id}%{tab}%{window-title}')"; then
  fail "Could not list windows; global reset was not started."
  exit 1
fi

failures=0
while IFS=$'\t' read -r window_id app_pid bundle_id window_title; do
  [ -n "$window_id" ] || continue
  if [ "$DRY_RUN" -eq 1 ]; then
    "$ROUTER" --force --dry-run -- "$window_id" "$app_pid" "$bundle_id" "$window_title" \
      || failures=$((failures + 1))
  else
    "$ROUTER" --force --quiet -- "$window_id" "$app_pid" "$bundle_id" "$window_title" \
      || failures=$((failures + 1))
  fi
done <<< "$windows"

for workspace in 1 2 3 4 5; do
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'would flatten, use h_tiles, and balance workspace=%s\n' "$workspace"
    continue
  fi
  "$AEROSPACE_BIN" flatten-workspace-tree --workspace "$workspace" \
    || failures=$((failures + 1))
  "$AEROSPACE_BIN" layout --workspace "$workspace" --root h_tiles \
    || failures=$((failures + 1))
  "$AEROSPACE_BIN" balance-sizes --workspace "$workspace" \
    || failures=$((failures + 1))
done

if [ "$failures" -gt 0 ]; then
  fail "Global reset incomplete: $failures operation(s) failed. See stderr for details."
  exit 1
fi
notify "Global reset complete: app placement and workspaces 1–5."
exit 0
