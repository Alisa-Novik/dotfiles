#!/usr/bin/env bash

# Move proven leaked snapshots off the displays without hiding their app.
# Navigation/focus callbacks run independently from direct hotkey actions.
set -u
umask 077

SCRIPT_PATH=$(/bin/realpath "${BASH_SOURCE[0]}")
SCAN_SOURCE="$(/usr/bin/dirname "$SCRIPT_PATH")/.aerospace-snapshot-scan.swift"
CACHE_DIR="${HOME}/Library/Caches/aerospace-ghost-guard"
SCANNER="${CACHE_DIR}/scan-onscreen-snapshots"
LOG_FILE="${HOME}/.local/state/aerospace-fullscreen.log"

mode="${1:---guard}"
case "$mode" in
    --guard|--background|--dry-run|--inspect|--prepare) ;;
    -h|--help)
        printf 'Usage: %s [--dry-run|--inspect|--background|--prepare]\n' "${0##*/}"
        exit 0 ;;
    *) printf 'Unknown option: %s\n' "$mode" >&2; exit 2 ;;
esac
if [[ $# -gt 1 && "${2:-}" != --locked ]] || [[ $# -gt 2 ]]; then
    printf 'Too many arguments\n' >&2
    exit 2
fi
/bin/mkdir -p "$CACHE_DIR" || exit 1

# Keep the inode: a kernel lock disappears with the process, unlike stale PIDs.
if [[ "${2:-}" != --locked ]]; then
    /usr/bin/lockf -ks -t 0 "$CACHE_DIR/recovery.lock" \
        /bin/bash "$SCRIPT_PATH" "$mode" --locked
    status=$?
    [[ $status -eq 75 ]] && exit 0
    exit "$status"
fi

if [[ ! -r "$SCAN_SOURCE" ]]; then
    printf 'Ghost guard source is missing: %s\n' "$SCAN_SOURCE" >&2
    exit 1
fi
if [[ ! -x "$SCANNER" || "$SCAN_SOURCE" -nt "$SCANNER" ]]; then
    temporary_scanner="${SCANNER}.$$"
    trap '/bin/rm -f "$temporary_scanner"' EXIT
    /usr/bin/swiftc -O "$SCAN_SOURCE" -o "$temporary_scanner" || exit 1
    /bin/chmod 700 "$temporary_scanner" || exit 1
    /bin/mv -f "$temporary_scanner" "$SCANNER" || exit 1
fi
[[ "$mode" == --prepare ]] && exit 0

if [[ "$mode" != --background ]]; then
    exec "$SCANNER" "$mode"
fi

# Back off after failures; a workspace switch must not repeatedly retry a move.
# Manual inspection/recovery remains available during the cooldown.
failure_marker="$CACHE_DIR/recovery-failed"
if [[ -e "$failure_marker" ]]; then
    failed_at=$(/usr/bin/stat -f %m "$failure_marker") || exit 1
    now=$(/bin/date +%s)
    (( now - failed_at < 60 )) && exit 0
fi

# Event-driven only. Allow Quartz to settle; never delay the navigation command.
/bin/mkdir -p "${LOG_FILE%/*}" || exit 1
for delay in 0.35 0.75; do
    /bin/sleep "$delay"
    result=$("$SCANNER" --guard 2>&1)
    status=$?
    printf '%s ghost-guard %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" "$result" >> "$LOG_FILE"
    if [[ $status -ne 0 ]]; then
        /usr/bin/touch "$failure_marker"
        exit "$status"
    fi
    # Also sample after transitions settle: a snapshot may appear later than
    # the first focus callback, or several leaked layers may belong to one app.
done
exit 0
